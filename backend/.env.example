# Application Settings
APP_NAME=Plant-Aid API
APP_DEBUG=True

# Security & JWT
SECRET_KEY=super-secret-plant-aid-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=5

# Database (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=sqlite:///./plant_aid.db

# Storage (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=plant-aid-media-bucket

# 2FA Notification Provider (console | twilio | sendgrid)
OTP_PROVIDER=console

# Twilio SMS (if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid Email (if OTP_PROVIDER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
